    }

    .section-pill-name {
        font-weight: 600;
        color: var(--text);
    }

    .section-pill-badge {
        font-size: 0.725rem;
        background: rgba(0, 0, 0, 0.05);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        color: var(--text-muted);
    }

    /* Common */
    .alert {
        padding: 0.85rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        margin-top: 0.75rem;
    }

    .alert-danger {
        background: var(--danger-light);
        border: 1px solid var(--danger-border);
        color: var(--danger);
