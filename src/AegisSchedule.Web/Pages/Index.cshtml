</style>

@section Scripts {
<script>
    let state = {
        primaryStandingLevel: 1,
        browsingLevel: 1,
        primaryLectureGroupName: null,
        primaryLabSectionName: null,
        minimizeDaysWeight: 0,
        minimizeGapsWeight: 0,
        preferredTimeBlock: "None",
        preferredTimeBlockWeight: 0,
        selectedOfferings: new Set(),
        currentLevelOfferings: [],
        allLoadedOfferings: new Map(),
        generatedSchedules: [],
        currentScheduleIndex: 0
    };

    document.addEventListener("DOMContentLoaded", () => {
        const initialPill = document.querySelector(".level-pill.active");
        const initialLevel = initialPill ? parseInt(initialPill.dataset.level) : 1;
        selectLevel(initialLevel);
    });

    async function selectLevel(levelNumber) {
        state.primaryStandingLevel = levelNumber;
        state.browsingLevel = levelNumber;

        document.querySelectorAll(".level-pill").forEach(btn => {
            btn.classList.toggle("active", parseInt(btn.dataset.level) === levelNumber);
        });

        document.querySelectorAll(".filter-btn").forEach(b => {
            b.classList.toggle("active", b.id === `filter-btn-${levelNumber}`);
        });

        await loadOfferingsForLevel(levelNumber, true);
        updateSelectedCounter();
        updateSelectedCoursesBar();
    }

    async function toggleBrowseLevel(levelNumber) {
        state.browsingLevel = levelNumber;

        document.querySelectorAll(".filter-btn").forEach(b => {
            b.classList.toggle("active", b.id === `filter-btn-${levelNumber}`);
        });

        await loadOfferingsForLevel(levelNumber, false);
    }

    async function loadOfferingsForLevel(levelNumber, isPrimaryStanding = false) {
        const spinner = document.getElementById("courseLoadingSpinner");
        const grid = document.getElementById("coursesGrid");

        spinner.style.display = "flex";
        grid.style.display = "none";

        try {
            const response = await fetch(`/Index?handler=Offerings&levelNumber=${levelNumber}`);
            if (!response.ok) throw new Error("Failed to load offerings");

            const offerings = await response.json();
            offerings.forEach(o => state.allLoadedOfferings.set(o.id, o));

            if (isPrimaryStanding) {
                populateCohortDropdowns(offerings);
            }

            if (levelNumber === state.browsingLevel) {
                state.currentLevelOfferings = offerings;
                renderCourseCards(offerings);
            }
        } catch (err) {
            console.error(err);
            grid.innerHTML = `
                <div class="status-alert error" style="grid-column: 1 / -1; margin: 1rem 0;">
                    <div>Error loading courses for Level ${levelNumber}: ${escapeHtml(err.message)}</div>
                    <button type="button" class="btn-subtle" style="margin-top: 0.5rem;" onclick="loadOfferingsForLevel(${levelNumber}, ${isPrimaryStanding})">Try Again</button>
                </div>`;
        } finally {
            spinner.style.display = "none";
            grid.style.display = "grid";
        }
    }

    function isLectureType(type) {
        const t = String(type || "").trim().toLowerCase();
        return t === "lecture" || t === "0";
    }

    function isLabType(type) {
        const t = String(type || "").trim().toLowerCase();
        return t === "lab" || t === "1";
    }

    function updateGroupDropdowns(offerings) {
        populateCohortDropdowns(offerings);
    }

    function populateCohortDropdowns(offerings) {
        const lectureSelect = document.getElementById("lectureGroupSelect");
        const labSelect = document.getElementById("labSectionSelect");
        if (!lectureSelect || !labSelect) return;

        const prevLecture = state.primaryLectureGroupName || lectureSelect.value;
        const prevLab = state.primaryLabSectionName || labSelect.value;

        lectureSelect.innerHTML = '<option value="">Any Lecture Group (Flexible)</option>';
        labSelect.innerHTML = '<option value="">Any Lab Section (Flexible)</option>';

        const lectureNames = new Set();
        const labNames = new Set();

        (offerings || []).forEach(offering => {
            (offering.groups || []).forEach(grp => {
                const name = (grp.name || "").trim();
                if (!name) return;

                if (isLectureType(grp.activityType)) {
                    lectureNames.add(name);
                } else if (isLabType(grp.activityType)) {
                    labNames.add(name);
                }
            });
        });

        const sortCollator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
        const sortedLectures = Array.from(lectureNames).sort(sortCollator.compare);
        const sortedLabs = Array.from(labNames).sort(sortCollator.compare);

        sortedLectures.forEach(name => {
            const opt = document.createElement("option");
            opt.value = name;
            opt.textContent = name;
            lectureSelect.appendChild(opt);
        });

        sortedLabs.forEach(name => {
            const opt = document.createElement("option");
            opt.value = name;
            opt.textContent = name;
            labSelect.appendChild(opt);
        });

        if (prevLecture && lectureNames.has(prevLecture)) {
            lectureSelect.value = prevLecture;
            state.primaryLectureGroupName = prevLecture;
        } else {
            lectureSelect.value = "";
            state.primaryLectureGroupName = null;
        }

        if (prevLab && labNames.has(prevLab)) {
            labSelect.value = prevLab;
            state.primaryLabSectionName = prevLab;
        } else {
            labSelect.value = "";
            state.primaryLabSectionName = null;
        }
    }

    function onLectureGroupChange() {
        const val = document.getElementById("lectureGroupSelect").value;
        state.primaryLectureGroupName = val ? val : null;
    }

    function onLabSectionChange() {
        const val = document.getElementById("labSectionSelect").value;
        state.primaryLabSectionName = val ? val : null;
    }

    function onPrefDaysChange() {
        const val = parseInt(document.getElementById("prefDaysSelect").value, 10);
        state.minimizeDaysWeight = isNaN(val) ? 0 : val;
    }

    function onPrefGapsChange() {
        const val = parseInt(document.getElementById("prefGapsSelect").value, 10);
        state.minimizeGapsWeight = isNaN(val) ? 0 : val;
    }

    function onPrefTimeBlockChange() {
        const val = document.getElementById("prefTimeBlockSelect").value;
        state.preferredTimeBlock = val;
        state.preferredTimeBlockWeight = val === "None" ? 0 : 3;
    }

    function renderCourseCards(offerings) {
        const grid = document.getElementById("coursesGrid");
        grid.innerHTML = "";

        if (!offerings || offerings.length === 0) {
            grid.innerHTML = `<p class="text-secondary" style="grid-column: 1 / -1; padding: 1.5rem; text-align: center;">No course offerings available for Level ${state.browsingLevel}.</p>`;
            return;
        }

        offerings.forEach(offering => {
            const isSelected = state.selectedOfferings.has(offering.id);
            const isCrossLevel = offering.academicLevelNumber !== state.primaryStandingLevel;

            const card = document.createElement("div");
            card.className = `course-card ${isSelected ? "selected" : ""}`;
            card.id = `course-card-${offering.id}`;
            card.onclick = () => toggleCourseSelection(offering.id);

            const badgesHtml = (offering.activityTypes || []).map(act => {
                const label = isLectureType(act) ? "Lecture" : isLabType(act) ? "Lab" : act;
                return `<span class="badge-act badge-${label}">${label}</span>`;
            }).join("");

            card.innerHTML = `
                <div>
                    <div class="course-card-header">
                        <span class="course-code">${escapeHtml(offering.courseCode)}</span>
                        <span class="level-tag ${isCrossLevel ? "cross-level" : ""}">
                            ${isCrossLevel ? `Cross-Lvl (L${offering.academicLevelNumber})` : `Level ${offering.academicLevelNumber}`}
                        </span>
                    </div>
                    <div class="course-title">${escapeHtml(offering.courseName)}</div>
                </div>
                <div class="course-card-footer">
                    <div class="activity-badges">${badgesHtml}</div>
                    <input type="checkbox" class="checkbox-custom" ${isSelected ? "checked" : ""} onclick="event.stopPropagation(); toggleCourseSelection('${offering.id}')" />
                </div>
            `;

            grid.appendChild(card);
        });
    }

    function toggleCourseSelection(offeringId) {
        if (state.selectedOfferings.has(offeringId)) {
            state.selectedOfferings.delete(offeringId);
        } else {
            state.selectedOfferings.add(offeringId);
        }

        const card = document.getElementById(`course-card-${offeringId}`);
        if (card) {
            const isSelected = state.selectedOfferings.has(offeringId);
            card.classList.toggle("selected", isSelected);
            const cb = card.querySelector(".checkbox-custom");
            if (cb) cb.checked = isSelected;
        }

        updateSelectedCounter();
        updateSelectedCoursesBar();
    }

    function selectAllCurrentLevel() {
        state.currentLevelOfferings.forEach(o => state.selectedOfferings.add(o.id));
        renderCourseCards(state.currentLevelOfferings);
        updateSelectedCounter();
        updateSelectedCoursesBar();
    }

    function clearCourseSelections() {
        state.selectedOfferings.clear();
        renderCourseCards(state.currentLevelOfferings);
        updateSelectedCounter();
        updateSelectedCoursesBar();
    }

    function updateSelectedCounter() {
        const badge = document.getElementById("selectedCountBadge");
        const count = state.selectedOfferings.size;
        badge.textContent = `${count} course${count === 1 ? "" : "s"} selected`;

        const generateBtn = document.getElementById("generateBtn");
        generateBtn.disabled = count === 0;
    }

    function updateSelectedCoursesBar() {
        const bar = document.getElementById("selectedCoursesBar");
        const list = document.getElementById("selectedChipsList");
        if (!bar || !list) return;

        if (state.selectedOfferings.size === 0) {
            bar.style.display = "none";
            list.innerHTML = "";
            return;
        }

        bar.style.display = "flex";
        list.innerHTML = "";

        state.selectedOfferings.forEach(offeringId => {
            const offering = state.allLoadedOfferings.get(offeringId);
            const chip = document.createElement("span");
            chip.className = "course-chip";
            const code = offering ? escapeHtml(offering.courseCode) : offeringId.substring(0, 6);
            const lvl = offering ? offering.academicLevelNumber : "?";
            chip.innerHTML = `
                <span>${code}</span>
                <span class="course-chip-lvl">L${lvl}</span>
                <button type="button" class="chip-remove" onclick="removeSelectedCourse('${offeringId}')" title="Remove ${code}">&times;</button>
            `;
            list.appendChild(chip);
        });
    }

    function removeSelectedCourse(offeringId) {
        toggleCourseSelection(offeringId);
    }

    async function retryConnection() {
        const btn = document.getElementById("retryConnectionBtn");
        const btnText = document.getElementById("retryBtnText");
        const spinner = document.getElementById("retrySpinner");
        const alertBox = document.getElementById("initErrorAlert");
        const msgSpan = document.getElementById("initErrorMessage");

        if (btn) btn.disabled = true;
        if (btnText) btnText.textContent = "Connecting...";
        if (spinner) spinner.style.display = "inline-block";

        try {
            const levelContainer = document.getElementById("levelButtonGroup");
            if (!levelContainer || levelContainer.children.length === 0) {
                const res = await fetch("/Index?handler=Levels");
                if (!res.ok) throw new Error("API backend is still unreachable.");
                const levels = await res.json();
                populateAcademicLevels(levels);
            }

            await selectLevel(state.primaryStandingLevel || 1);
            if (alertBox) alertBox.style.display = "none";
        } catch (err) {
            console.error("Retry failed:", err);
            if (msgSpan) msgSpan.textContent = `Connection retry failed: ${err.message}`;
        } finally {
            if (btn) btn.disabled = false;
            if (btnText) btnText.textContent = "Retry Connection";
            if (spinner) spinner.style.display = "none";
        }
    }

    function populateAcademicLevels(levels) {
        const pillGroup = document.getElementById("levelButtonGroup");
        const filterGroup = document.getElementById("crossLevelButtons");
        if (!pillGroup || !filterGroup || !levels) return;

        pillGroup.innerHTML = "";
        filterGroup.innerHTML = "";

        levels.forEach(lvl => {
            const pill = document.createElement("button");
            pill.type = "button";
            pill.className = `level-pill ${lvl.levelNumber === state.primaryStandingLevel ? "active" : ""}`;
            pill.dataset.level = lvl.levelNumber;
            pill.textContent = `Level ${lvl.levelNumber}`;
            pill.onclick = () => selectLevel(lvl.levelNumber);
            pillGroup.appendChild(pill);

            const filterBtn = document.createElement("button");
            filterBtn.type = "button";
            filterBtn.className = `filter-btn ${lvl.levelNumber === state.browsingLevel ? "active" : ""}`;
            filterBtn.id = `filter-btn-${lvl.levelNumber}`;
            filterBtn.textContent = `Level ${lvl.levelNumber}`;
            filterBtn.onclick = () => toggleBrowseLevel(lvl.levelNumber);
            filterGroup.appendChild(filterBtn);
        });
    }

    async function generateSchedule() {
        if (state.selectedOfferings.size === 0) return;

        const btn = document.getElementById("generateBtn");
        const btnText = btn.querySelector(".btn-text");
        const btnSpinner = document.getElementById("btnSpinner");
        const statusAlert = document.getElementById("statusAlert");
        const resultsSection = document.getElementById("resultsSection");

        btn.disabled = true;
        btnText.textContent = "Generating...";
        btnSpinner.style.display = "inline-block";
        statusAlert.style.display = "none";

        const requestPayload = {
            academicLevelNumber: state.primaryStandingLevel,
            primaryLectureGroupName: state.primaryLectureGroupName || null,
            primaryLabSectionName: state.primaryLabSectionName || null,
            selectedCourseOfferingIds: Array.from(state.selectedOfferings),
            minimizeDaysWeight: state.minimizeDaysWeight,
            minimizeGapsWeight: state.minimizeGapsWeight,
            preferredTimeBlock: state.preferredTimeBlock,
            preferredTimeBlockWeight: state.preferredTimeBlockWeight
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        try {
            const response = await fetch("/Index?handler=Generate", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify(requestPayload)
            });

            if (!response.ok) {
                const errText = await response.text();
                throw new Error(errText || "Schedule computation failed.");
            }

            const data = await response.json();

            if (!data.isSuccess || !data.schedules || data.schedules.length === 0) {
                statusAlert.className = "status-alert warning";
                const evalCount = data.totalCombinationsEvaluated || 0;
                let tipHtml = "";
                if (state.primaryLectureGroupName || state.primaryLabSectionName) {
                    tipHtml = `<div class="status-alert-tip"><strong>Tip:</strong> Try relaxing Primary Lecture Group or Primary Lab Section to <em>"Flexible"</em> to allow alternate class sections.</div>`;
                } else {
                    tipHtml = `<div class="status-alert-tip"><strong>Tip:</strong> Mutually exclusive class times detected across selected courses (${state.selectedOfferings.size} courses). Try unchecking one course to isolate schedule collisions.</div>`;
                }
                statusAlert.innerHTML = `
                    <div class="status-alert-title">${escapeHtml(data.errorMessage) || `No conflict-free schedules found from ${evalCount} evaluated combination${evalCount === 1 ? "" : "s"}.`}</div>
                    ${tipHtml}
                `;
                statusAlert.style.display = "block";
                resultsSection.style.display = "none";
                return;
            }

            state.generatedSchedules = data.schedules;
            state.currentScheduleIndex = 0;

            statusAlert.className = "status-alert success";
            statusAlert.innerHTML = `<div class="status-alert-title">Found ${data.schedules.length} conflict-free schedule(s) from ${data.totalCombinationsEvaluated} evaluated combinations.</div>`;
            statusAlert.style.display = "block";

            renderActiveSchedule();
            resultsSection.style.display = "flex";
            resultsSection.scrollIntoView({ behavior: "smooth" });

        } catch (err) {
            console.error(err);
            statusAlert.className = "status-alert error";
            statusAlert.innerHTML = `<div class="status-alert-title">Error: ${escapeHtml(err.message)}</div>`;
            statusAlert.style.display = "block";
            resultsSection.style.display = "none";
        } finally {
            btn.disabled = false;
            btnText.textContent = "Generate Schedule";
            btnSpinner.style.display = "none";
        }
    }

    function getCourseName(courseCode) {
        if (!courseCode) return "";
        if (state.allLoadedOfferings) {
            for (const offering of state.allLoadedOfferings.values()) {
                if (offering.courseCode === courseCode && offering.courseName) {
                    return offering.courseName;
                }
            }
        }
        if (state.currentLevelOfferings) {
            for (const offering of state.currentLevelOfferings) {
                if (offering.courseCode === courseCode && offering.courseName) {
                    return offering.courseName;
                }
            }
        }
        return courseCode;
    }

    function formatGroupLabel(activityType, rawGroupName) {
        const clean = (rawGroupName || "").trim();

        if (isLectureType(activityType)) {
            if (/^lecture\s+group/i.test(clean)) return clean;
            if (/^group/i.test(clean)) return `Lecture ${clean}`;
            return `Lecture Group ${clean}`;
        } else if (isLabType(activityType)) {
            if (/^lab\s+section/i.test(clean)) return clean;
            if (/^section/i.test(clean)) return `Lab ${clean}`;
            return `Lab Section ${clean}`;
        }
        return `Lecture Group ${clean}`.trim();
    }

    function createMeetingCard(item) {
        const card = document.createElement("div");
        card.className = `grid-cell-meeting type-${item.activityType}`;
        const courseName = getCourseName(item.courseCode);
        const groupLabel = formatGroupLabel(item.activityType, item.groupName);

        card.innerHTML = `
            <div class="cell-top-bar">
                <span class="cell-course-code">${escapeHtml(item.courseCode)}</span>
                <span class="cell-act-type">${escapeHtml(item.activityType)}</span>
            </div>
            <div class="cell-course-title" title="${escapeHtml(courseName)}">${escapeHtml(courseName)}</div>
            <div class="cell-bottom-meta">
                <span class="cell-group-label">${escapeHtml(groupLabel)}</span>
                <span class="cell-room-badge">${escapeHtml(item.meeting.room || "Room TBA")}</span>
            </div>
        `;
        return card;
    }

    function renderActiveSchedule() {
        const schedules = state.generatedSchedules;
        if (!schedules || schedules.length === 0) return;

        const schedule = schedules[state.currentScheduleIndex];
        const grid = document.getElementById("timetableGrid");
        const pageIndicator = document.getElementById("schedulePageIndicator");
        const prevBtn = document.getElementById("prevScheduleBtn");
        const nextBtn = document.getElementById("nextScheduleBtn");
        const statsLabel = document.getElementById("resultsStats");
        const printMeta = document.getElementById("printScheduleMeta");

        const rank = schedule.rank || (state.currentScheduleIndex + 1);
        const score = schedule.overallScore != null ? schedule.overallScore : 100;
        const breakdown = schedule.scoreBreakdown || {};
        const daysText = breakdown.totalDays ? `${breakdown.totalDays} Days` : "";
        const gapText = breakdown.totalGapHours != null ? `${breakdown.totalGapHours}h Gaps` : "";
        const alignText = breakdown.timeBlockAlignmentPercentage != null && state.preferredTimeBlock !== "None" ? `${Math.round(breakdown.timeBlockAlignmentPercentage)}% Time Match` : "";

        const metaParts = [daysText, gapText, alignText].filter(Boolean).join(", ");
        const metaSuffix = metaParts ? ` • ${metaParts}` : "";

        pageIndicator.textContent = `Option ${state.currentScheduleIndex + 1} of ${schedules.length}`;
        prevBtn.disabled = state.currentScheduleIndex === 0;
        nextBtn.disabled = state.currentScheduleIndex === schedules.length - 1;

        statsLabel.innerHTML = `
            <span class="rank-badge ${rank === 1 ? "best-match" : ""}">Rank #${rank}</span>
            <span class="score-pill">${Math.round(score)}% Match</span>
            <span class="text-secondary">${schedule.selectedGroups.length} Sections${metaSuffix}</span>
        `;

        if (printMeta) {
            printMeta.textContent = `Level ${state.primaryStandingLevel} • Option ${state.currentScheduleIndex + 1} of ${schedules.length} (Rank #${rank} • ${Math.round(score)}% Match • ${schedule.selectedGroups.length} Sections)`;
        }

        const meetingsList = [];
        (schedule.selectedGroups || []).forEach(group => {
            (group.meetings || []).forEach(meeting => {
                meetingsList.push({
                    courseCode: group.courseCode,
                    groupName: group.groupName,
                    activityType: group.activityType,
                    meeting: meeting
                });
            });
        });

        // DYNAMIC DAY OF WEEK EXTRACTION (Never hardcoded)
        const daySequence = ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
        const rawDays = [...new Set(meetingsList.map(item => normalizeDayOfWeek(item.meeting.dayOfWeek)))];
        rawDays.sort((a, b) => daySequence.indexOf(a) - daySequence.indexOf(b));

        // DYNAMIC TIME SLOT EXTRACTION
        const rawTimeSlots = [...new Set(meetingsList.map(item => `${item.meeting.startTime} - ${item.meeting.endTime}`))];
        rawTimeSlots.sort((a, b) => a.localeCompare(b));

        if (rawDays.length === 0 || rawTimeSlots.length === 0) {
            grid.innerHTML = `<p class="text-secondary" style="padding: 2rem; text-align: center;">No scheduled meetings in this combination.</p>`;
            return;
        }

        // PIVOTED GRID: Days as Rows, Time Slots as Columns
        grid.style.gridTemplateColumns = `130px repeat(${rawTimeSlots.length}, minmax(180px, 1fr))`;
        grid.innerHTML = "";

        // Top Header: Corner Cell
        const cornerCell = document.createElement("div");
        cornerCell.className = "grid-cell-header";
        cornerCell.textContent = "Day / Time";
        grid.appendChild(cornerCell);

        // Top Header: Time Slot Columns
        rawTimeSlots.forEach(slot => {
            const timeHeader = document.createElement("div");
            timeHeader.className = "grid-cell-header time-header";
            timeHeader.textContent = slot;
            grid.appendChild(timeHeader);
        });

        // Rows for each Day
        rawDays.forEach(day => {
            const dayLabel = document.createElement("div");
            dayLabel.className = "day-row-label";
            dayLabel.textContent = day;
            grid.appendChild(dayLabel);

            rawTimeSlots.forEach(slot => {
                const matchingItems = meetingsList.filter(item => 
                    normalizeDayOfWeek(item.meeting.dayOfWeek) === day &&
                    `${item.meeting.startTime} - ${item.meeting.endTime}` === slot
                );

                if (matchingItems.length > 0) {
                    const cell = document.createElement("div");
                    cell.className = "grid-cell-container";

                    matchingItems.forEach(item => {
                        cell.appendChild(createMeetingCard(item));
                    });
                    grid.appendChild(cell);
                } else {
                    const emptyCell = document.createElement("div");
                    emptyCell.className = "grid-cell-empty";
                    grid.appendChild(emptyCell);
                }
            });
        });

        renderSelectedGroupsList(schedule.selectedGroups);
    }

    function renderSelectedGroupsList(groups) {
        const list = document.getElementById("selectedGroupsList");
        list.innerHTML = "";

        (groups || []).forEach(group => {
            const pill = document.createElement("div");
            pill.className = "section-pill";
            const courseName = getCourseName(group.courseCode);
            const groupLabel = formatGroupLabel(group.activityType, group.groupName);

            pill.innerHTML = `
                <span class="section-pill-code">${escapeHtml(group.courseCode)}</span>
                <span class="section-pill-name">${escapeHtml(courseName)}</span>
                <span class="section-pill-badge">${escapeHtml(groupLabel)}</span>
            `;
            list.appendChild(pill);
        });
    }

    function prevSchedule() {
        if (state.currentScheduleIndex > 0) {
            state.currentScheduleIndex--;
            renderActiveSchedule();
        }
    }

    function nextSchedule() {
        if (state.currentScheduleIndex < state.generatedSchedules.length - 1) {
            state.currentScheduleIndex++;
            renderActiveSchedule();
        }
    }

    function normalizeDayOfWeek(day) {
        if (typeof day === "string") return day;
        const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        return days[day] || `Day ${day}`;
    }

    function escapeHtml(str) {
        if (!str) return "";
        return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>
}
