        color: var(--text-secondary);
        white-space: nowrap;
    }

    .selected-chips-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        align-items: center;
    }

    .course-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--primary-light);
        border: 1px solid var(--primary-border);
        color: var(--primary);
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-size: 0.775rem;
        font-weight: 600;
    }

    .course-chip-lvl {
        font-size: 0.7rem;
        background: rgba(37, 99, 235, 0.12);
        padding: 0.05rem 0.3rem;
        border-radius: 4px;
        color: var(--primary);
    }

    .chip-remove {
        background: transparent;
        border: none;
        color: var(--primary);
        cursor: pointer;
        font-size: 0.9rem;
        line-height: 1;
        padding: 0 0.15rem;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chip-remove:hover {
        background: rgba(220, 38, 38, 0.15);
        color: var(--danger);
    }

    /* Collision Diagnostics */
    .status-alert-title {
        font-weight: 600;
    }

    .status-alert-tip {
        margin-top: 0.45rem;
        font-size: 0.85rem;
        padding-top: 0.4rem;
        border-top: 1px dashed rgba(217, 119, 6, 0.3);
    }

    /* Print Header (hidden on screen) */
    .print-only-header {
        display: none;
    }

    /* Print & PDF Export Stylesheet */
    @@media print {
        @@page {
            size: landscape;
            margin: 0.8cm;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            background: #ffffff !important;
            color: #0f172a !important;
            font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
