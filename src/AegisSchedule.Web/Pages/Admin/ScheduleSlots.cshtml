@section Scripts {
<script>
    const SCROLL_STORAGE_KEY = "uni_admin_schedule_scroll_y";
    const ROOM_STORAGE_KEY = "uni_admin_last_room";

    function getStoredRoom(actType) {
        try {
            if (actType) {
                const specific = localStorage.getItem(`uni_admin_last_room_${actType}`);
                if (specific) return specific;
            }
            return localStorage.getItem(ROOM_STORAGE_KEY) || "";
        } catch {
            return "";
        }
    }

    function setStoredRoom(room, actType) {
        if (!room) return;
        try {
            const trimmed = room.trim();
            if (actType) {
                localStorage.setItem(`uni_admin_last_room_${actType}`, trimmed);
            }
            localStorage.setItem(ROOM_STORAGE_KEY, trimmed);
        } catch {}
    }

    function syncRoomInputs(room, actType) {
        if (!room) return;
        const selector = actType ? `.activity-block[data-activity-type='${actType}'] .input-room` : ".input-room";
        document.querySelectorAll(selector).forEach(inp => {
            if (!inp.value || inp.value.trim() === "") {
                inp.value = room;
            }
        });
    }

    function saveRoomOnSubmit(form, actType) {
        const act = actType || form.dataset.activityType || form.closest(".activity-block")?.dataset.activityType || "";
        const roomInput = form.querySelector(".input-room");
        if (roomInput && roomInput.value.trim()) {
            const val = roomInput.value.trim();
            setStoredRoom(val, act);
            syncRoomInputs(val, act);
        }
    }

    function setPresetInputs(btn, start, end) {
        const form = btn.closest("form");
        if (!form) return;

        const startInput = form.querySelector("input[name='startTime']");
        const endInput = form.querySelector("input[name='endTime']");
        if (startInput) startInput.value = start;
        if (endInput) endInput.value = end;

        const pillGroup = btn.closest(".preset-pill-group");
        if (pillGroup) {
            pillGroup.querySelectorAll(".btn-preset-pill").forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
        }
    }

    function onTimeInputChange(input) {
        const form = input.closest("form");
        if (!form) return;
        const startInput = form.querySelector("input[name='startTime']");
        const endInput = form.querySelector("input[name='endTime']");
        const pillGroup = form.querySelector(".preset-pill-group");
        if (!pillGroup || !startInput || !endInput) return;

        const currentPair = `${startInput.value}-${endInput.value}`;
        pillGroup.querySelectorAll(".btn-preset-pill").forEach(p => {
            const pPair = p.textContent.replace('–', '-').replace('—', '-').trim();
            if (pPair === currentPair) {
                p.classList.add("active");
            } else {
                p.classList.remove("active");
            }
        });
    }

    function toggleEditMeetingRow(rowId) {
        const row = document.getElementById(rowId);
        if (!row) return;
        const isHidden = (row.style.display === "none" || !row.style.display);
        row.style.display = isHidden ? "table-row" : "none";
        if (isHidden) {
            const startInput = row.querySelector("input[name='startTime']");
            if (startInput) {
                onTimeInputChange(startInput);
            }
            const roomInp = row.querySelector(".input-room");
            if (roomInp && !roomInp.value) {
                const actType = row.closest(".activity-block")?.dataset.activityType || "";
                roomInp.value = getStoredRoom(actType);
            }
        }
    }

    function toggleExtraSlotRow(rowId) {
        const row = document.getElementById(rowId);
        if (!row) return;
        const isHidden = (row.style.display === "none" || !row.style.display);
        row.style.display = isHidden ? "table-row" : "none";
        if (isHidden) {
            const startInput = row.querySelector("input[name='startTime']");
            if (startInput) {
                onTimeInputChange(startInput);
            }
            const roomInp = row.querySelector(".input-room");
            if (roomInp && !roomInp.value) {
                const actType = row.closest(".activity-block")?.dataset.activityType || "";
                roomInp.value = getStoredRoom(actType);
            }
        }
    }

    function copyMeetingToInlineForm(btn, day, start, end, room) {
        const tr = btn.closest("tr");
        if (!tr) return;
        const form = tr.querySelector("form");
        if (!form) return;

        const daySelect = form.querySelector("select[name='dayOfWeek']");
        const startInp = form.querySelector("input[name='startTime']");
        const endInp = form.querySelector("input[name='endTime']");
        const roomInp = form.querySelector("input[name='room']");

        if (daySelect) daySelect.value = day;
        if (startInp) startInp.value = start;
        if (endInp) endInp.value = end;
        if (roomInp && room) roomInp.value = room;

        if (startInp) {
            onTimeInputChange(startInp);
        }
    }

    function openDuplicateMeetingModal(meetingId, sourceGroupId, dayOfWeek, startTime, endTime, room, sectionTitle) {
        const infoSpan = document.getElementById("duplicateSourceInfo");
        if (infoSpan) {
            infoSpan.textContent = `${sectionTitle} (${dayOfWeek} ${startTime}–${endTime})`;
        }
        const groupSelect = document.getElementById("duplicateTargetGroupId");
        if (groupSelect) {
            groupSelect.value = sourceGroupId;
        }
        const daySelect = document.getElementById("duplicateDayOfWeek");
        if (daySelect) {
            daySelect.value = dayOfWeek;
        }
        const startInp = document.getElementById("duplicateStartTime");
        if (startInp) {
            startInp.value = startTime;
        }
        const endInp = document.getElementById("duplicateEndTime");
        if (endInp) {
            endInp.value = endTime;
        }
        const roomInp = document.getElementById("duplicateRoom");
        if (roomInp) {
            roomInp.value = room || "";
        }

        document.getElementById("duplicateMeetingModal").style.display = "flex";
    }

    function formatSectionName(activityType, groupName) {
        const clean = (groupName || "").trim();
        const t = String(activityType || "").trim().toLowerCase();
        if (t === "lab" || t === "1") {
            if (/^lab\s+section/i.test(clean)) return clean;
            if (/^section/i.test(clean)) return `Lab ${clean}`;
            return `Lab Section ${clean}`;
        }
        if (/^lecture\s+group/i.test(clean)) return clean;
        if (/^group/i.test(clean)) return `Lecture ${clean}`;
        return `Lecture Group ${clean}`;
    }

    function openDeleteActivityModal(activityId, activityType) {
        document.getElementById("deleteActivityId").value = activityId;
        document.getElementById("deleteActivityName").textContent = activityType;
        document.getElementById("deleteActivityModal").style.display = "flex";
    }

    function openDeleteGroupModal(groupId, groupTitle) {
        document.getElementById("deleteGroupId").value = groupId;
        document.getElementById("deleteGroupName").textContent = groupTitle;
        document.getElementById("deleteGroupModal").style.display = "flex";
    }

    function openDeleteMeetingModal(meetingId, dayTimeRoom) {
        document.getElementById("deleteMeetingId").value = meetingId;
        document.getElementById("deleteMeetingDetails").textContent = dayTimeRoom;
        document.getElementById("deleteMeetingModal").style.display = "flex";
    }

    function closeModal(id) {
        document.getElementById(id).style.display = "none";
    }

    window.onclick = function(event) {
        if (event.target.classList.contains("modal-backdrop")) {
            event.target.style.display = "none";
        }
    }

    // Preserve scroll position across page reloads / POST submissions
    window.addEventListener("beforeunload", () => {
        sessionStorage.setItem(SCROLL_STORAGE_KEY, window.scrollY.toString());
    });

    document.addEventListener("DOMContentLoaded", () => {
        // Automatic Scroll to Error Alert Banner if an error occurred (e.g. meeting overlap)
        const errorBanner = document.getElementById("errorAlertBanner");
        if (errorBanner) {
            errorBanner.scrollIntoView({ behavior: "smooth", block: "center" });
            sessionStorage.removeItem(SCROLL_STORAGE_KEY);
        } else {
            // Restore scroll position
            const savedY = sessionStorage.getItem(SCROLL_STORAGE_KEY);
            if (savedY !== null) {
                const y = parseInt(savedY, 10);
                if (!isNaN(y)) {
                    window.scrollTo({ top: y, behavior: "instant" });
                    requestAnimationFrame(() => {
                        window.scrollTo({ top: y, behavior: "instant" });
                    });
                    setTimeout(() => {
                        window.scrollTo({ top: y, behavior: "instant" });
                    }, 50);
                }
                sessionStorage.removeItem(SCROLL_STORAGE_KEY);
            }
        }

        // Initialize smart room memory per activity block
        document.querySelectorAll(".activity-block").forEach(block => {
            const actType = block.dataset.activityType || "";
            const stored = getStoredRoom(actType);
            if (stored) {
                syncRoomInputs(stored, actType);
            }
        });

        document.querySelectorAll(".input-room").forEach(inp => {
            inp.addEventListener("change", () => {
                if (inp.value.trim()) {
                    const actType = inp.closest(".activity-block")?.dataset.activityType || "";
                    setStoredRoom(inp.value.trim(), actType);
                    syncRoomInputs(inp.value.trim(), actType);
                }
            });
        });
    });
</script>
}
