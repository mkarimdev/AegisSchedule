<!-- Modal: Duplicate Meeting Slot -->
<div id="duplicateMeetingModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Clone Meeting Slot</h3>
            <button type="button" class="btn-close" onclick="closeModal('duplicateMeetingModal')">&times;</button>
        </div>
        <form method="post" asp-page-handler="DuplicateMeeting">
            <input type="hidden" name="offeringId" value="@Model.OfferingDetail?.Id" />
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.85rem;">
                    Source: <strong id="duplicateSourceInfo" class="text-primary"></strong>
                </p>

                <div class="form-group" style="margin-bottom: 0.85rem;">
                    <label class="form-label" for="duplicateTargetGroupId">Target Section Group</label>
                    <select id="duplicateTargetGroupId" name="targetGroupId" class="form-select" required>
                        @if (Model.OfferingDetail != null)
                        {
                            @foreach (var act in Model.OfferingDetail.Activities)
                            {
                                <optgroup label="@act.Type Sections">
                                    @foreach (var g in act.Groups)
                                    {
                                        <option value="@g.Id">@FormatSectionTitle(act.Type, g.Name)</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 0.85rem;">
                    <label class="form-label" for="duplicateDayOfWeek">Target Day</label>
                    <select id="duplicateDayOfWeek" name="dayOfWeek" class="form-select" required>
                        <option value="Saturday">Saturday</option>
                        <option value="Sunday">Sunday</option>
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                    </select>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-bottom: 0.85rem;">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label" for="duplicateStartTime">Start Time</label>
                        <input type="time" id="duplicateStartTime" name="startTime" class="form-input" required />
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label" for="duplicateEndTime">End Time</label>
                        <input type="time" id="duplicateEndTime" name="endTime" class="form-input" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="duplicateRoom">Room (Optional)</label>
                    <input type="text" id="duplicateRoom" name="room" class="form-input" placeholder="e.g. Hall 1 or Lab B" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-subtle" onclick="closeModal('duplicateMeetingModal')">Cancel</button>
                <button type="submit" class="btn-primary">Clone Slot</button>
            </div>
        </form>
    </div>
</div>

