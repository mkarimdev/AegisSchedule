@page
@model AegisSchedule.Web.Pages.Admin.ScheduleSlotsModel
@{
    ViewData["Title"] = "Schedule Slots & Timetable - Admin";
}

@functions {
    public static bool IsLabType(string activityType)
    {
        var t = activityType?.Trim().ToLowerInvariant() ?? "";
        return t == "lab" || t == "1";
    }

    public static string GetSectionHeader(string activityType) =>
        IsLabType(activityType) ? "Lab Sections" : "Lecture Groups";

    public static string GetSectionPlaceholder(string activityType) =>
        IsLabType(activityType) ? "e.g. 1, 16 or Section B" : "e.g. 1, 2 or Group A";

    public static string GetAddButtonLabel(string activityType) =>
        IsLabType(activityType) ? "+ Add Lab Section" : "+ Add Lecture Group";

    public static string GetActivityTypeBadge(string activityType) =>
        IsLabType(activityType) ? "Lab" : "Lecture";

    public static string FormatSectionTitle(string activityType, string groupName)
    {
        var clean = groupName?.Trim() ?? "";
        if (IsLabType(activityType))
        {
            return clean.StartsWith("Lab Section", StringComparison.OrdinalIgnoreCase)
                ? clean
                : clean.StartsWith("Section", StringComparison.OrdinalIgnoreCase)
                    ? $"Lab {clean}"
                    : $"Lab Section {clean}";
        }

        // Map unmapped, numeric (e.g. "0", "2", old Tutorial), or any other type to Lecture Group by default
        return clean.StartsWith("Lecture Group", StringComparison.OrdinalIgnoreCase)
            ? clean
            : clean.StartsWith("Group", StringComparison.OrdinalIgnoreCase)
                ? $"Lecture {clean}"
                : $"Lecture Group {clean}";
    }

    public static string FormatSectionName(string activityType, string groupName) => FormatSectionTitle(activityType, groupName);
    public static string formatSectionName(string activityType, string groupName) => FormatSectionTitle(activityType, groupName);
}

<div class="admin-container">
    <partial name="_AdminNav" model="@("ScheduleSlots")" />

    <div class="admin-header-row">
        <div>
            <h1>Schedule Slots & Meeting Timetabler</h1>
            <p class="admin-subtitle">High-density instructional timetable editor with rapid period presets and smart room memory.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div id="errorAlertBanner" class="alert alert-danger">
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Sticky Course Context Header Bar -->
    <div class="sticky-course-header card">
        <div class="sticky-header-row">
            <form method="get" class="context-selector-form">
                <label for="offeringSelect" class="form-label" style="margin-bottom: 0;">Course Offering:</label>
                <select id="offeringSelect" name="OfferingId" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width: 440px;">
                    @if (Model.AllOfferings.Count == 0)
                    {
                        <option value="">No course offerings available</option>
                    }
                    @foreach (var off in Model.AllOfferings)
                    {
                        <option value="@off.Id" selected="@(Model.OfferingId == off.Id)">
                            @off.CourseCode - @off.CourseName (@off.TermName &bull; Level @off.AcademicLevelNumber)
                        </option>
                    }
                </select>
            </form>

            @if (Model.OfferingDetail != null)
            {
                <div class="sticky-offering-meta">
                    <span class="course-code-badge large">@Model.OfferingDetail.CourseCode</span>
                    <span class="sticky-course-title">@Model.OfferingDetail.CourseName</span>
                    <span class="level-pill-badge">Level @Model.OfferingDetail.AcademicLevelNumber</span>
                    <span class="text-secondary" style="font-size: 0.8rem;">&bull; @Model.OfferingDetail.TermName</span>
                </div>

                <!-- Add Category Dropdown (if any remaining) -->
                var existingTypes = Model.OfferingDetail.Activities.Select(a => a.Type).ToHashSet(StringComparer.OrdinalIgnoreCase);
                var allTypes = new[] { AegisSchedule.Web.Models.ActivityType.Lecture, AegisSchedule.Web.Models.ActivityType.Lab };
                var availableTypes = allTypes.Where(t => !existingTypes.Contains(t.ToString())).ToList();

                if (availableTypes.Count > 0)
                {
                    <form method="post" asp-page-handler="CreateActivity" class="add-act-form">
                        <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                        <select name="type" class="form-select form-select-sm" required style="width: auto;">
                            @foreach (var t in availableTypes)
                            {
                                <option value="@((int)t)">+ Add @t Category</option>
                            }
                        </select>
                        <button type="submit" class="btn-primary btn-sm">+ Add Category</button>
                    </form>
                }
            }
        </div>
    </div>

    @if (Model.OfferingDetail == null)
    {
        <div class="card empty-state">
            <p>Please select a course offering above or create an offering in <a href="/Admin/Offerings" style="color: var(--primary); font-weight: 600;">Terms & Offerings</a>.</p>
        </div>
    }
    else
    {
        @if (Model.OfferingDetail.Activities.Count == 0)
        {
            <div class="card empty-state">
                <p>No activity categories configured yet. Add a <strong>Lecture</strong> or <strong>Lab</strong> category in the top toolbar.</p>
            </div>
        }

        <!-- Hierarchical Tree: Activities -> Groups -> Meetings -->
        @foreach (var activity in Model.OfferingDetail.Activities)
        {
            <div class="activity-block card" data-activity-type="@activity.Type">
                <div class="activity-block-header">
                    <div class="activity-title-group">
                        <span class="badge-act badge-@GetActivityTypeBadge(activity.Type) large">@GetActivityTypeBadge(activity.Type)</span>
                        <h3 class="activity-section-header">@GetSectionHeader(activity.Type)</h3>
                        <span class="text-secondary" style="font-size: 0.85rem;">(@activity.Groups.Count @(IsLabType(activity.Type) ? "section" : "group")@(activity.Groups.Count == 1 ? "" : "s"))</span>
                    </div>

                    <button type="button" class="btn-subtle text-danger" onclick="openDeleteActivityModal('@activity.Id', '@GetActivityTypeBadge(activity.Type)')">
                        Remove @GetActivityTypeBadge(activity.Type) Category
                    </button>
                </div>

                <!-- Quick-Add Section Bar -->
                <div class="quick-add-section-bar">
                    <form method="post" asp-page-handler="CreateGroup" class="quick-add-section-form">
                        <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                        <input type="hidden" name="activityId" value="@activity.Id" />
                        <span class="quick-add-label">+ New Section:</span>
                        <input type="text" name="name" class="form-input form-input-sm quick-add-input" placeholder="@GetSectionPlaceholder(activity.Type)" required />
                        <button type="submit" class="btn-primary btn-sm quick-add-btn">@GetAddButtonLabel(activity.Type)</button>
                    </form>
                </div>

                <!-- High-Density Section Data Table -->
                @if (activity.Groups.Count == 0)
                {
                    <div class="empty-sections-note">
                        <span>No sections created yet for @GetActivityTypeBadge(activity.Type). Use the quick-add bar above to create sections.</span>
                    </div>
                }
                else
                {
                    <div class="section-table-card">
                        <table class="section-data-table">
                            <thead>
                                <tr>
                                    <th style="width: 170px;">Section Name</th>
                                    <th>Assigned Weekly Meeting</th>
                                    <th style="width: 130px;">Room</th>
                                    <th style="width: 270px; text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in activity.Groups)
                                {
                                    var sectionTitle = FormatSectionTitle(activity.Type, group.Name);
                                    if (group.Meetings.Count == 0)
                                    {
                                        var priorGroupWithMeeting = activity.Groups.FirstOrDefault(g => g.Id != group.Id && g.Meetings.Count > 0);
                                        var priorMeeting = priorGroupWithMeeting?.Meetings.FirstOrDefault();
                                        <!-- Unassigned Section Row: Shows inline slot creator directly in table -->
                                        <tr>
                                            <td class="col-section font-semibold">
                                                <div class="section-title-wrap">
                                                    <span class="section-name">@sectionTitle</span>
                                                    <button type="button" class="btn-icon-delete" title="Delete section" onclick="openDeleteGroupModal('@group.Id', '@sectionTitle')">&times;</button>
                                                </div>
                                            </td>
                                            <td colspan="3" class="col-inline-slot-entry">
                                                <form method="post" asp-page-handler="CreateMeeting" class="inline-slot-entry-form" onsubmit="saveRoomOnSubmit(this, '@activity.Type')">
                                                    <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                                                    <input type="hidden" name="groupId" value="@group.Id" />

                                                    <div class="inline-entry-grid">
                                                        <select name="dayOfWeek" class="form-select form-select-xs select-day" required>
                                                            <option value="Saturday">Saturday</option>
                                                            <option value="Sunday">Sunday</option>
                                                            <option value="Monday">Monday</option>
                                                            <option value="Tuesday">Tuesday</option>
                                                            <option value="Wednesday">Wednesday</option>
                                                            <option value="Thursday">Thursday</option>
                                                            <option value="Friday">Friday</option>
                                                        </select>

                                                        <input type="time" name="startTime" class="form-input form-input-xs input-time" value="09:00" oninput="onTimeInputChange(this)" required title="Start Time" />
                                                        <span class="time-sep">&ndash;</span>
                                                        <input type="time" name="endTime" class="form-input form-input-xs input-time" value="11:00" oninput="onTimeInputChange(this)" required title="End Time" />

                                                        <div class="preset-pill-group">
                                                            <button type="button" class="btn-preset-pill active" onclick="setPresetInputs(this, '09:00', '11:00')">09:00–11:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '11:00', '13:00')">11:00–13:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '13:00', '15:00')">13:00–15:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '15:00', '17:00')">15:00–17:00</button>
                                                        </div>

                                                        <input type="text" name="room" placeholder="Room (opt)" class="form-input form-input-xs input-room" />

                                                        <button type="submit" class="btn-primary btn-xs btn-save-slot">+ Save Slot</button>

                                                        @if (priorMeeting != null && priorGroupWithMeeting != null)
                                                        {
                                                            var priorTitle = FormatSectionTitle(activity.Type, priorGroupWithMeeting.Name);
                                                            var shortDay = priorMeeting.DayOfWeek.ToString().Length >= 3 ? priorMeeting.DayOfWeek.ToString().Substring(0, 3) : priorMeeting.DayOfWeek.ToString();
                                                            <div class="quick-copy-wrap">
                                                                <button type="button" class="btn-copy-chip" title="Copy timing and room from @priorTitle" onclick="copyMeetingToInlineForm(this, '@priorMeeting.DayOfWeek', '@priorMeeting.StartTime', '@priorMeeting.EndTime', '@(priorMeeting.Room ?? "")')">
                                                                    📋 Copy from @priorTitle (@shortDay @priorMeeting.StartTime&ndash;@priorMeeting.EndTime@(string.IsNullOrEmpty(priorMeeting.Room) ? "" : $" • {priorMeeting.Room}"))
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    else if (group.Meetings.Count == 1)
                                    {
                                        <!-- Single Slot Section Row (Default Model for 95% of Sections) -->
                                        var m = group.Meetings[0];
                                        <tr>
                                            <td class="col-section font-semibold">
                                                <div class="section-title-wrap">
                                                    <span class="section-name">@sectionTitle</span>
                                                    <button type="button" class="btn-icon-delete" title="Delete section" onclick="openDeleteGroupModal('@group.Id', '@sectionTitle')">&times;</button>
                                                </div>
                                            </td>
                                            <td class="col-meeting">
                                                <span class="badge-slot-day">@m.DayOfWeek</span>
                                                <span class="badge-slot-time">@m.StartTime &ndash; @m.EndTime</span>
                                            </td>
                                            <td class="col-room">
                                                <span class="tag-room">@(string.IsNullOrWhiteSpace(m.Room) ? "TBA" : m.Room)</span>
                                            </td>
                                            <td class="col-actions">
                                                <button type="button" class="btn-outline btn-xs" title="Edit this slot inline" onclick="toggleEditMeetingRow('edit-meeting-@m.Id')">Edit</button>
                                                <button type="button" class="btn-outline btn-xs" title="Clone / duplicate this slot" onclick="openDuplicateMeetingModal('@m.Id', '@group.Id', '@m.DayOfWeek', '@m.StartTime', '@m.EndTime', '@(m.Room ?? "")', '@sectionTitle')">Clone</button>
                                                <button type="button" class="btn-action delete btn-xs" title="Remove this slot" onclick="openDeleteMeetingModal('@m.Id', '@m.DayOfWeek (@m.StartTime - @m.EndTime)')">Remove Slot</button>
                                                <button type="button" class="btn-outline btn-xs" title="Add another slot to this section" onclick="toggleExtraSlotRow('extra-@group.Id')">+ Extra Slot</button>
                                            </td>
                                        </tr>
                                        <!-- Collapsible Inline Edit Slot Row -->
                                        <tr id="edit-meeting-@m.Id" class="edit-slot-row" style="display: none;">
                                            <td class="col-section-sub">
                                                <span class="badge-edit-label">✎ Edit Slot:</span>
                                            </td>
                                            <td colspan="3" class="col-inline-slot-entry">
                                                <form method="post" asp-page-handler="UpdateMeeting" class="inline-slot-entry-form" onsubmit="saveRoomOnSubmit(this, '@activity.Type')">
                                                    <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                                                    <input type="hidden" name="meetingId" value="@m.Id" />

                                                    <div class="inline-entry-grid">
                                                        <select name="dayOfWeek" class="form-select form-select-xs select-day" required>
                                                            <option value="Saturday" selected="@(m.DayOfWeek == DayOfWeek.Saturday)">Saturday</option>
                                                            <option value="Sunday" selected="@(m.DayOfWeek == DayOfWeek.Sunday)">Sunday</option>
                                                            <option value="Monday" selected="@(m.DayOfWeek == DayOfWeek.Monday)">Monday</option>
                                                            <option value="Tuesday" selected="@(m.DayOfWeek == DayOfWeek.Tuesday)">Tuesday</option>
                                                            <option value="Wednesday" selected="@(m.DayOfWeek == DayOfWeek.Wednesday)">Wednesday</option>
                                                            <option value="Thursday" selected="@(m.DayOfWeek == DayOfWeek.Thursday)">Thursday</option>
                                                            <option value="Friday" selected="@(m.DayOfWeek == DayOfWeek.Friday)">Friday</option>
                                                        </select>

                                                        <input type="time" name="startTime" class="form-input form-input-xs input-time" value="@m.StartTime" oninput="onTimeInputChange(this)" required title="Start Time" />
                                                        <span class="time-sep">&ndash;</span>
                                                        <input type="time" name="endTime" class="form-input form-input-xs input-time" value="@m.EndTime" oninput="onTimeInputChange(this)" required title="End Time" />

                                                        <div class="preset-pill-group">
                                                            <button type="button" class="btn-preset-pill @(m.StartTime == "09:00" && m.EndTime == "11:00" ? "active" : "")" onclick="setPresetInputs(this, '09:00', '11:00')">09:00–11:00</button>
                                                            <button type="button" class="btn-preset-pill @(m.StartTime == "11:00" && m.EndTime == "13:00" ? "active" : "")" onclick="setPresetInputs(this, '11:00', '13:00')">11:00–13:00</button>
                                                            <button type="button" class="btn-preset-pill @(m.StartTime == "13:00" && m.EndTime == "15:00" ? "active" : "")" onclick="setPresetInputs(this, '13:00', '15:00')">13:00–15:00</button>
                                                            <button type="button" class="btn-preset-pill @(m.StartTime == "15:00" && m.EndTime == "17:00" ? "active" : "")" onclick="setPresetInputs(this, '15:00', '17:00')">15:00–17:00</button>
                                                        </div>

                                                        <input type="text" name="room" value="@m.Room" placeholder="Room (opt)" class="form-input form-input-xs input-room" />

                                                        <button type="submit" class="btn-primary btn-xs btn-save-slot">Save Changes</button>
                                                        <button type="button" class="btn-subtle btn-xs" onclick="toggleEditMeetingRow('edit-meeting-@m.Id')">Cancel</button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                        <!-- Expandable Extra Slot Row -->
                                        <tr id="extra-@group.Id" class="extra-slot-row" style="display: none;">
                                            <td class="col-section-sub">
                                                <span class="text-secondary text-xs">↳ Extra Slot:</span>
                                            </td>
                                            <td colspan="3" class="col-inline-slot-entry">
                                                <form method="post" asp-page-handler="CreateMeeting" class="inline-slot-entry-form" onsubmit="saveRoomOnSubmit(this, '@activity.Type')">
                                                    <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                                                    <input type="hidden" name="groupId" value="@group.Id" />

                                                    <div class="inline-entry-grid">
                                                        <select name="dayOfWeek" class="form-select form-select-xs select-day" required>
                                                            <option value="Saturday">Saturday</option>
                                                            <option value="Sunday">Sunday</option>
                                                            <option value="Monday">Monday</option>
                                                            <option value="Tuesday">Tuesday</option>
                                                            <option value="Wednesday">Wednesday</option>
                                                            <option value="Thursday">Thursday</option>
                                                            <option value="Friday">Friday</option>
                                                        </select>

                                                        <input type="time" name="startTime" class="form-input form-input-xs input-time" value="09:00" oninput="onTimeInputChange(this)" required title="Start Time" />
                                                        <span class="time-sep">&ndash;</span>
                                                        <input type="time" name="endTime" class="form-input form-input-xs input-time" value="11:00" oninput="onTimeInputChange(this)" required title="End Time" />

                                                        <div class="preset-pill-group">
                                                            <button type="button" class="btn-preset-pill active" onclick="setPresetInputs(this, '09:00', '11:00')">09:00–11:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '11:00', '13:00')">11:00–13:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '13:00', '15:00')">13:00–15:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '15:00', '17:00')">15:00–17:00</button>
                                                        </div>

                                                        <input type="text" name="room" placeholder="Room (opt)" class="form-input form-input-xs input-room" />

                                                        <button type="submit" class="btn-primary btn-xs btn-save-slot">+ Save Extra Slot</button>
                                                        <button type="button" class="btn-subtle btn-xs" onclick="toggleExtraSlotRow('extra-@group.Id')">Cancel</button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <!-- Multi-Slot Section Row -->
                                        <tr>
                                            <td class="col-section font-semibold">
                                                <div class="section-title-wrap">
                                                    <span class="section-name">@sectionTitle</span>
                                                    <span class="slot-count-badge">@(group.Meetings.Count) slots</span>
                                                    <button type="button" class="btn-icon-delete" title="Delete section" onclick="openDeleteGroupModal('@group.Id', '@sectionTitle')">&times;</button>
                                                </div>
                                            </td>
                                            <td colspan="2" class="col-meeting-multi">
                                                <div class="multi-slots-container">
                                                    @foreach (var meeting in group.Meetings)
                                                    {
                                                        <div class="multi-slot-item">
                                                            <span class="badge-slot-day">@meeting.DayOfWeek</span>
                                                            <span class="badge-slot-time">@meeting.StartTime &ndash; @meeting.EndTime</span>
                                                            <span class="tag-room">@(string.IsNullOrWhiteSpace(meeting.Room) ? "TBA" : meeting.Room)</span>
                                                            <button type="button" class="btn-icon-action" title="Edit slot inline" onclick="toggleEditMeetingRow('edit-meeting-@meeting.Id')">✎</button>
                                                            <button type="button" class="btn-icon-action" title="Clone / duplicate slot" onclick="openDuplicateMeetingModal('@meeting.Id', '@group.Id', '@meeting.DayOfWeek', '@meeting.StartTime', '@meeting.EndTime', '@(meeting.Room ?? "")', '@sectionTitle')">⧉</button>
                                                            <button type="button" class="btn-icon-delete" title="Remove slot" onclick="openDeleteMeetingModal('@meeting.Id', '@meeting.DayOfWeek (@meeting.StartTime - @meeting.EndTime)')">&times;</button>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td class="col-actions">
                                                <button type="button" class="btn-outline btn-xs" title="Add another slot to this section" onclick="toggleExtraSlotRow('extra-@group.Id')">+ Extra Slot</button>
                                            </td>
                                        </tr>
                                        @foreach (var meeting in group.Meetings)
                                        {
                                            <!-- Collapsible Inline Edit Slot Row for Multi-Slot Item -->
                                            <tr id="edit-meeting-@meeting.Id" class="edit-slot-row" style="display: none;">
                                                <td class="col-section-sub">
                                                    <span class="badge-edit-label">✎ Edit Slot:</span>
                                                </td>
                                                <td colspan="3" class="col-inline-slot-entry">
                                                    <form method="post" asp-page-handler="UpdateMeeting" class="inline-slot-entry-form" onsubmit="saveRoomOnSubmit(this, '@activity.Type')">
                                                        <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                                                        <input type="hidden" name="meetingId" value="@meeting.Id" />

                                                        <div class="inline-entry-grid">
                                                            <select name="dayOfWeek" class="form-select form-select-xs select-day" required>
                                                                <option value="Saturday" selected="@(meeting.DayOfWeek == DayOfWeek.Saturday)">Saturday</option>
                                                                <option value="Sunday" selected="@(meeting.DayOfWeek == DayOfWeek.Sunday)">Sunday</option>
                                                                <option value="Monday" selected="@(meeting.DayOfWeek == DayOfWeek.Monday)">Monday</option>
                                                                <option value="Tuesday" selected="@(meeting.DayOfWeek == DayOfWeek.Tuesday)">Tuesday</option>
                                                                <option value="Wednesday" selected="@(meeting.DayOfWeek == DayOfWeek.Wednesday)">Wednesday</option>
                                                                <option value="Thursday" selected="@(meeting.DayOfWeek == DayOfWeek.Thursday)">Thursday</option>
                                                                <option value="Friday" selected="@(meeting.DayOfWeek == DayOfWeek.Friday)">Friday</option>
                                                            </select>

                                                            <input type="time" name="startTime" class="form-input form-input-xs input-time" value="@meeting.StartTime" oninput="onTimeInputChange(this)" required title="Start Time" />
                                                            <span class="time-sep">&ndash;</span>
                                                            <input type="time" name="endTime" class="form-input form-input-xs input-time" value="@meeting.EndTime" oninput="onTimeInputChange(this)" required title="End Time" />

                                                            <div class="preset-pill-group">
                                                                <button type="button" class="btn-preset-pill @(meeting.StartTime == "09:00" && meeting.EndTime == "11:00" ? "active" : "")" onclick="setPresetInputs(this, '09:00', '11:00')">09:00–11:00</button>
                                                                <button type="button" class="btn-preset-pill @(meeting.StartTime == "11:00" && meeting.EndTime == "13:00" ? "active" : "")" onclick="setPresetInputs(this, '11:00', '13:00')">11:00–13:00</button>
                                                                <button type="button" class="btn-preset-pill @(meeting.StartTime == "13:00" && meeting.EndTime == "15:00" ? "active" : "")" onclick="setPresetInputs(this, '13:00', '15:00')">13:00–15:00</button>
                                                                <button type="button" class="btn-preset-pill @(meeting.StartTime == "15:00" && meeting.EndTime == "17:00" ? "active" : "")" onclick="setPresetInputs(this, '15:00', '17:00')">15:00–17:00</button>
                                                            </div>

                                                            <input type="text" name="room" value="@meeting.Room" placeholder="Room (opt)" class="form-input form-input-xs input-room" />

                                                            <button type="submit" class="btn-primary btn-xs btn-save-slot">Save Changes</button>
                                                            <button type="button" class="btn-subtle btn-xs" onclick="toggleEditMeetingRow('edit-meeting-@meeting.Id')">Cancel</button>
                                                        </div>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                        <!-- Expandable Extra Slot Row -->
                                        <tr id="extra-@group.Id" class="extra-slot-row" style="display: none;">
                                            <td class="col-section-sub">
                                                <span class="text-secondary text-xs">↳ Extra Slot:</span>
                                            </td>
                                            <td colspan="3" class="col-inline-slot-entry">
                                                <form method="post" asp-page-handler="CreateMeeting" class="inline-slot-entry-form" onsubmit="saveRoomOnSubmit(this, '@activity.Type')">
                                                    <input type="hidden" name="offeringId" value="@Model.OfferingDetail.Id" />
                                                    <input type="hidden" name="groupId" value="@group.Id" />

                                                    <div class="inline-entry-grid">
                                                        <select name="dayOfWeek" class="form-select form-select-xs select-day" required>
                                                            <option value="Saturday">Saturday</option>
                                                            <option value="Sunday">Sunday</option>
                                                            <option value="Monday">Monday</option>
                                                            <option value="Tuesday">Tuesday</option>
                                                            <option value="Wednesday">Wednesday</option>
                                                            <option value="Thursday">Thursday</option>
                                                            <option value="Friday">Friday</option>
                                                        </select>

                                                        <input type="time" name="startTime" class="form-input form-input-xs input-time" value="09:00" oninput="onTimeInputChange(this)" required title="Start Time" />
                                                        <span class="time-sep">&ndash;</span>
                                                        <input type="time" name="endTime" class="form-input form-input-xs input-time" value="11:00" oninput="onTimeInputChange(this)" required title="End Time" />

                                                        <div class="preset-pill-group">
                                                            <button type="button" class="btn-preset-pill active" onclick="setPresetInputs(this, '09:00', '11:00')">09:00–11:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '11:00', '13:00')">11:00–13:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '13:00', '15:00')">13:00–15:00</button>
                                                            <button type="button" class="btn-preset-pill" onclick="setPresetInputs(this, '15:00', '17:00')">15:00–17:00</button>
                                                        </div>

                                                        <input type="text" name="room" placeholder="Room (opt)" class="form-input form-input-xs input-room" />

                                                        <button type="submit" class="btn-primary btn-xs btn-save-slot">+ Save Extra Slot</button>
                                                        <button type="button" class="btn-subtle btn-xs" onclick="toggleExtraSlotRow('extra-@group.Id')">Cancel</button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

